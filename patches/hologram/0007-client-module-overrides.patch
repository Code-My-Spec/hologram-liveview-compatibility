+
+  # shortcut: `config :hologram, client_module_overrides: [{Mod, StandIn}]` compiles StandIn's functions as Mod for the
+  # browser (the server keeps the real Mod). For modules whose real code can't run client-side but a few functions can.
+  # StandIn's own name stays reachable. Upgrade: a documented Hologram option, with a cache key like server_only_modules.
+  defp override_for_client(ir, module) do
+    case List.keyfind(Application.get_env(:hologram, :client_module_overrides, []), module, 0) do
+      {^module, stand_in} ->
+        stand_in_ir = for_module(stand_in)
+        %{stand_in_ir | module: %IR.AtomType{value: module}}
+
+      nil ->
+        ir
+    end
   end
 
